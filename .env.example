# ---------- Instagram (official Graph API) ----------
# Long-lived access token for YOUR Instagram Business/Creator account.
IG_ACCESS_TOKEN=
# "me" works with Instagram Login (graph.instagram.com).
# With Facebook Login use your numeric IG user id and IG_API_BASE=https://graph.facebook.com
IG_USER_ID=me
IG_API_BASE=https://graph.instagram.com
# Optional, e.g. v23.0. Leave empty to use the default version.
IG_API_VERSION=

# ---------- Bunny Storage ----------
# Storage zone name and its password (Storage Zone -> FTP & API Access -> Password).
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
# Region prefix of the zone's main region. Empty = Falkenstein (DE).
# Options: uk, ny, la, sg, se, br, jh, syd
BUNNY_STORAGE_REGION=
# Reels are stored in a folder named after the Instagram username: <zone>/<username>/
# Optional parent folder, e.g. "instagram" -> <zone>/instagram/<username>/
BUNNY_BASE_PATH=

# Account API key (Account settings -> API). Only needed for `create-zone`.
BUNNY_API_KEY=

# Pull zone hostname linked to the storage zone (CDN -> your pull zone -> Hostnames).
# Needed for `publish`: Instagram downloads each video from this public URL.
# e.g. my-reels.b-cdn.net
BUNNY_CDN_HOSTNAME=

# ---------- publish ----------
# The access token above must be allowed to publish content
# (Instagram Login: instagram_business_basic + instagram_business_content_publish).
# INSTAGRAM_TOKEN / INSTAGRAM_USER_ID / INSTAGRAM_API_VERSION are accepted as aliases.
