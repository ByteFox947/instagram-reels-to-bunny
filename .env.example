# ---------- Instagram (official Graph API) ----------
# Long-lived access token for YOUR Instagram Business/Creator account.
IG_ACCESS_TOKEN=
# "me" works with Instagram Login (graph.instagram.com).
# With Facebook Login use your numeric IG user id and IG_API_BASE=https://graph.facebook.com
IG_USER_ID=me
IG_API_BASE=https://graph.instagram.com
# Optional, e.g. v23.0. Leave empty to use the default version.
IG_API_VERSION=

# ---------- Bunny Storage ----------
# Storage zone name and its password (Storage Zone -> FTP & API Access -> Password).
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
# Region prefix of the zone's main region. Empty = Falkenstein (DE).
# Options: uk, ny, la, sg, se, br, jh, syd
BUNNY_STORAGE_REGION=
# Folder inside the zone where reels are stored
BUNNY_BASE_PATH=instagram/reels

# Account API key (Account settings -> API). Only needed for `create-zone`.
BUNNY_API_KEY=
